---
import Layout from "@/layouts/Layout.astro";
import { formatDate } from "@/lib/format";
import { getPostsByType, getPublishedDate, loadPublishedDates, sortByDate } from "@/lib/posts";

const publishedDates = loadPublishedDates();
const posts = sortByDate(getPostsByType("thought"), publishedDates);
---

<Layout
	title="Thoughts"
	description="소프트웨어 엔지니어링, AI 시대의 개발, 도메인 지식과 커리어에 대한 단상과 에세이 목록."
	showSearch
>
	<h1>Thoughts</h1>

	{posts.length === 0 ? (
		<p>No posts yet.</p>
	) : (
		<div class="timeline">
			{posts.map((post) => {
				const date = getPublishedDate(post, publishedDates);
				return (
					<article>
						<time datetime={date}>{formatDate(date)}</time>
						<h2><a href={`/thought/${post.slug}`}>{post.title}</a></h2>
					</article>
				);
			})}
		</div>
	)}
</Layout>

<style>
	h1 {
		margin-bottom: 2rem;
	}
	.timeline {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	article {
		display: flex;
		align-items: baseline;
		gap: 1rem;
	}
	article time {
		flex-shrink: 0;
		width: 6rem;
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}
	article h2 {
		margin: 0;
		font-size: 1rem;
		font-weight: normal;
	}
	article h2 a {
		text-decoration: none;
	}
	article h2 a:hover {
		text-decoration: underline;
	}
</style>
