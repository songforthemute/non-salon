{
	"name": "non-salon",
	"private": true,
	"description": "non.salon monorepo",
	"author": "songforthemute",
	"license": "MIT",
	"packageManager": "pnpm@10.13.1",
	"scripts": {
		"dev": "pnpm --filter @non-salon/blog dev",
		"build": "pnpm --filter @non-salon/blog build",
		"build:ci": "pnpm --filter @non-salon/blog build:ci",
		"preview": "pnpm --filter @non-salon/blog preview",
		"test:run": "pnpm -r --if-present test:run",
		"typecheck": "pnpm -r --if-present typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.12"
	}
}
