---
import PostArticle from "@/components/PostArticle.astro";
import { getTilPosts, loadPosts, loadPublishedDates } from "@/lib/posts";
import type { Post } from "@/types";

export function getStaticPaths() {
	return getTilPosts(loadPosts()).map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props as { post: Post };
const publishedDates = loadPublishedDates();
---

<PostArticle post={post} publishedDates={publishedDates} til />
