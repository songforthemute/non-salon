---
import PostArticle from "@/components/PostArticle.astro";
import { ROUTE_TYPE_MAP, type RouteSegment } from "@/config";
import { getPostsByType, loadPublishedDates } from "@/lib/posts";
import type { Post } from "@/types";

export function getStaticPaths() {
	const paths: Array<{ params: { type: RouteSegment; slug: string }; props: { post: Post } }> = [];

	for (const [routeSegment, contentType] of Object.entries(ROUTE_TYPE_MAP)) {
		const posts = getPostsByType(contentType);
		for (const post of posts) {
			paths.push({
				params: { type: routeSegment as RouteSegment, slug: post.slug },
				props: { post },
			});
		}
	}

	return paths;
}

const { post } = Astro.props as { post: Post };
const publishedDates = loadPublishedDates();
---

<PostArticle post={post} publishedDates={publishedDates} />
