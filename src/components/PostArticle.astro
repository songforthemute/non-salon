---
import Layout from "@/layouts/Layout.astro";
import { blocksToHtml } from "@/lib/block-to-html";
import { formatDate } from "@/lib/format";
import { getPublishedDate, isTilPost } from "@/lib/posts";
import { getArticleModifiedDate } from "@/lib/seo";
import type { Post } from "@/types";

interface Props {
	post: Post;
	publishedDates: Record<string, string>;
}

const { post, publishedDates } = Astro.props;
const til = isTilPost(post);
const publishedDate = getPublishedDate(post, publishedDates);
const modifiedDate = getArticleModifiedDate(post, publishedDate);
const content = blocksToHtml(post.blocks);
const topics = post.tags;
---

<Layout
	title={post.title}
	description={post.description || undefined}
	ogType="article"
	ogImage={til ? undefined : `${post.type}-${post.slug}.png`}
	publishedDate={publishedDate}
	modifiedDate={modifiedDate}
	section={post.type}
	tags={topics}
	noindex={til}
>
	<article>
		<header>
			<h1>{post.title}</h1>
			<time datetime={publishedDate}>{formatDate(publishedDate)}</time>
			{post.description && <p class="summary">{post.description}</p>}
			{topics.length > 0 && <p class="tags">{topics.join(", ")}</p>}
		</header>
		<div class="content" data-pagefind-body set:html={content} />
	</article>
</Layout>

<style>
	article header { margin-bottom: 2rem; }
	article h1 { margin-bottom: 0.5rem; }
	article time { color: var(--color-muted); }
	.summary { margin-top: 1rem; color: var(--color-subtle); }
	.tags { margin-top: 0.5rem; font-size: var(--font-size-sm); color: var(--color-muted); }
</style>
